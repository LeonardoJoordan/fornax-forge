# Ambientes virtuais e configuração local
venv/
env/
.venv/
.venv-*/
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Bytecode, caches e cobertura Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
/coverage.xml
*.egg-info/

# Dados gerados localmente (os modelos de assets/templates são versionados)
/output/
/models/*
!/models/.gitkeep
/.validation/
/logs/

# Compilação, Nuitka e repositório Flatpak local
/build/
/dist/
*.build/
*.dist/
/*.bin
/.flatpak-builder/
/build-dir/
/repo/

# Sistema operacional e IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Pacotes para distribuição, ferramentas de empacotamento e relatórios locais
# Inclui nomes atuais, versionados e legados do Projeto ComSoc.
*.flatpak
*.AppImage
*.AppImage.sha256
*.AppDir/
*.dmg
/FORNAX*.exe
/Instalador-FORNAX*.exe
/appimagetool
/appimagetool-*.AppImage
/nuitka-crash-report.xml

# Rascunhos de release e registros locais de validação
/RELEASE_v*.md
/docs/VALIDACAO_APPIMAGE_LINUX.md

# Evidências locais de testes e benchmarks
# Versionar documentação e scripts, sem logs, capturas, resultados brutos,
# cópias de fontes, patches de referência ou arquivos compactados das rodadas.
*.log
/docs/desempenho_editor/**
!/docs/desempenho_editor/**/
!/docs/desempenho_editor/**/*.md
!/docs/desempenho_editor/**/*.py
# Entrada exigida por tests/performance/run_final_benchmarks.py.
!/docs/desempenho_editor/etapa-00/antes.json
/docs/implementacao_tabelas/**
!/docs/implementacao_tabelas/**/
!/docs/implementacao_tabelas/**/*.md
!/docs/implementacao_tabelas/**/*.py
